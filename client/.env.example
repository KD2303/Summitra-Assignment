# =============================================================================
# Summitra Client — Environment Configuration Template (Vercel)
# =============================================================================

# Render Backend URL (Example: https://summitra-api.onrender.com)
# When provided, all REST API calls and Socket.IO real-time seat tracking
# will automatically target your Render backend service.
VITE_API_URL=https://your-backend-service.onrender.com

# Optional WebSocket URL override (falls back to VITE_API_URL origin if omitted)
# VITE_SOCKET_URL=https://your-backend-service.onrender.com
