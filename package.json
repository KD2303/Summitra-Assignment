{
  "name": "summitra-smart-event-booking",
  "version": "1.0.0",
  "description": "Smart Event Booking System with real-time seat tracking and row-lock concurrency control",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"magenta,cyan\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "seed": "npm run seed --workspace=server",
    "test:concurrency": "npm run test:concurrency --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
