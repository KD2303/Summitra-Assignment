# =============================================================================
# Summitra Server — Environment Configuration Template
# =============================================================================

# Server Port (Render automatically sets PORT to 10000 or assigned port)
PORT=5000
NODE_ENV=production

# Allowed Frontend Origins for CORS & Socket.IO (comma-separated, or Vercel URL)
# Example: https://summitra.vercel.app,http://localhost:5173
CLIENT_ORIGIN=https://your-vercel-app.vercel.app,http://localhost:5173

# --- Database Options ---
# Option A: Single Connection URI (e.g., Aiven, PlanetScale, Railway, TiDB)
# DATABASE_URL=mysql://user:password@host:3306/event_booking?ssl={"rejectUnauthorized":false}

# Option B: Discrete Parameters (Local or Cloud MySQL / MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=event_booking
DB_SSL=false

# Note: If MySQL is not reachable or credentials are not supplied,
# Summitra will automatically operate in High-Performance In-Memory DB Mode!

# --- Security & Cryptography ---
JWT_SECRET=generate_a_random_secure_32_char_secret_key_here
JWT_EXPIRES_IN=24h
